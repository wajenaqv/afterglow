{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AfterGlow",
  "version": "0.1.5",
  "identifier": "com.wajenaqv.afterglow",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNzIzMkJDRUFGRDk5RTQKUldUa21mM3F2REp5L0tWTC83S0QxZ3hYeDNOcU1aQ2xQajVSV0thVzFScFBRUTM3cGJTSUQ2bzkK",
      "endpoints": ["https://github.com/wajenaqv/afterglow/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mohammad Wajih",
    "copyright": "© 2026 Mohammad Wajih. MIT License.",
    "category": "Utility",
    "shortDescription": "Live ASCII wallpapers that glow when something happens",
    "longDescription": "AfterGlow puts glowing text-art wallpapers (jellyfish, paw prints) behind your desktop icons on every monitor, pauses them for fullscreen apps and games, and will let your apps nudge them when something is waiting.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
