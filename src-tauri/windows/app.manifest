<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  AfterGlow's Windows application manifest (embedded by build.rs).
  The msix element gives the plain .exe "package identity" once the sparse
  package in scripts/windows/ is registered (register-package.ps1); without
  it, Windows ignores the element and the app runs as before. Package
  identity is what the notification listener (connectors/notifications.rs)
  needs. publisher must match the Publisher in AppxManifest.xml and the
  signing certificate's subject.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="AfterGlow" type="win32" />
  <msix xmlns="urn:schemas-microsoft-com:msix.v1" publisher="CN=AfterGlow Dev" packageName="AfterGlow" applicationId="AfterGlow" />
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
