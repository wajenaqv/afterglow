# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Runtime tokens (OAuth refresh tokens etc.) live in the OS keychain, not here.

# Gmail connector (Google Cloud OAuth client, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook connector (Microsoft Entra app registration, public client)
MICROSOFT_CLIENT_ID=

# Spotify connector (developer.spotify.com app, redirect http://127.0.0.1:<port>/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
