<?xml version="1.0" encoding="utf-8"?>
<!--
  A "sparse" package for AfterGlow: it contains no files, it points at the
  folder where afterglow.exe already is (Add-AppxPackage -ExternalLocation)
  and gives it package identity, which Windows' notification listener needs
  (the userNotificationListener capability). register-package.ps1 packs,
  signs and registers it. Publisher must match src-tauri/windows/app.manifest
  and the certificate the script makes.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="AfterGlow" Publisher="CN=AfterGlow Dev" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AfterGlow</DisplayName>
    <PublisherDisplayName>Mohammad Wajih</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
  <Applications>
    <Application Id="AfterGlow" Executable="afterglow.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="AfterGlow" Description="Live ASCII wallpapers that glow when something happens" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
